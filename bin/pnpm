#!/usr/bin/env bash
# 6529-repo-command-wrapper

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${SEIZE_6529_COMMAND:-0}" != "1" && "${SEIZE_SECURE_INSTALL:-0}" != "1" ]]; then
  echo "Direct pnpm usage is blocked in this repository." >&2
  echo "Use the \`6529\` wrapper instead." >&2
  echo "Examples:" >&2
  echo "  6529 ci" >&2
  echo "  6529 run dev" >&2
  echo "  6529 run build" >&2
  exit 1
fi

# shellcheck source=bin/wrapper-lib.sh
source "$SCRIPT_DIR/wrapper-lib.sh"

seize_wrapper_enter pnpm

# Never a wrapper of this repository: not this one in any PATH spelling, and
# not the one of another checkout. See bin/wrapper-lib.sh.
REAL_PNPM="$(seize_wrapper_resolve pnpm "$SCRIPT_DIR")"

if [[ -z "$REAL_PNPM" ]]; then
  echo "Unable to locate the real pnpm binary outside the repo wrapper path." >&2
  exit 1
fi

exec "$REAL_PNPM" "$@"
