{
  "styles": "\n#legacy-browser-notice{display:none}\nhtml[data-legacy-browser] body>:not(#legacy-browser-notice){display:none!important}\nhtml[data-legacy-browser] #legacy-browser-notice{position:fixed;top:0;right:0;bottom:0;left:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;background:#080a09;color:#f1f2f2;font-family:-apple-system,BlinkMacSystemFont,Arial,sans-serif;text-align:center;padding:24px;box-sizing:border-box}\n#legacy-browser-notice [data-legacy-variant]{display:none;max-width:28rem}\nhtml[data-legacy-browser=\"ios\"] #legacy-browser-notice [data-legacy-variant=\"ios\"]{display:block}\nhtml[data-legacy-browser=\"other\"] #legacy-browser-notice [data-legacy-variant=\"other\"]{display:block}\n#legacy-browser-notice h1{margin:0 0 12px;font-size:22px;font-weight:600;line-height:1.3}\n#legacy-browser-notice p{margin:0;font-size:16px;line-height:1.5;color:#c9cdcb}\n",
  "flagScript": "window.__6529LegacyBrowser=true;",
  "syntaxScript": "void class{static{window.__6529LegacyBrowser=false}};",
  "noticeScript": "(function(){try{if(window.__6529LegacyBrowser!==true)return;var n=navigator;var ios=/iPad|iPhone|iPod/.test(n.userAgent)||(n.platform===\"MacIntel\"&&n.maxTouchPoints>1);document.documentElement.setAttribute(\"data-legacy-browser\",ios?\"ios\":\"other\")}catch(e){}})();",
  "noticeHtml": "<div id=\"legacy-browser-notice\"><section data-legacy-variant=\"ios\" aria-labelledby=\"legacy-browser-notice-ios\"><h1 id=\"legacy-browser-notice-ios\">6529 needs iOS 16.4 or later</h1><p>Update in Settings &gt; General &gt; Software Update, then open 6529 again.</p></section><section data-legacy-variant=\"other\" aria-labelledby=\"legacy-browser-notice-other\"><h1 id=\"legacy-browser-notice-other\">6529 needs a newer browser</h1><p>Update your browser to its latest version, then open 6529 again.</p></section></div>",
  "attribute": "data-legacy-browser"
}
