{
  "name": "6529-device-farm-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Appium smoke suites executed on AWS Device Farm real devices. Packaged via npm pack (bundleDependencies) and uploaded by .github/workflows/device-farm-qa.yml; not part of the pnpm workspace.",
  "scripts": {
    "test": "npm run test:web",
    "test:unit": "node --test unit/*.test.cjs",
    "test:web": "node ./node_modules/mocha/bin/mocha.js specs/web.smoke.spec.cjs --timeout 900000 --retries 0 --reporter ./lib/reporter.cjs --fail-zero --forbid-pending",
    "test:native": "node ./node_modules/mocha/bin/mocha.js specs/native-android.smoke.spec.cjs --timeout 900000 --retries 1 --reporter spec"
  },
  "dependencies": {
    "mocha": "^11.1.0",
    "webdriverio": "^9.12.2"
  },
  "bundleDependencies": true
}
