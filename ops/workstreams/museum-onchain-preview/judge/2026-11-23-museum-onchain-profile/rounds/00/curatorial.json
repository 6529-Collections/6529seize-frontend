  "findings": [
    {
      "id": "C-001",
      "targets": [
        "J14",
        "J01"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain · default · 1440x1000, 820x1000, 390x844 · en-US",
      "evidence": "evidence/index-1440x1000-01.png",
      "observation": "The index is a flat wall of equal thumbnails: 6 photographs and 1 Molnar still under 'Works in the collection', 16 selected works under 'Works selected, not in the collection', each captioned only with title and artist. The seven Casey Reas works, the bulk of the 6529NM.2026.001 accession, appear as a text-only list below an explanatory sentence. Rows of unequal image height leave large empty areas under captions.",
      "consequence": "A visitor cannot tell which works are the collection's core or what the accessions are. Captions give no year, medium or accession, so the index reads as a file listing, not a catalogue of a collection.",
      "change": "Group the collection works under their accessions (Casey Reas, Conflict at Its Edges, Vera Molnar) with a one-line accession statement each, add year to each caption, and give the Reas works a labelled block of their own instead of a bare list. Keep images at their native aspect ratio.",
      "acceptance_check": "At all three widths the collection section shows accession groupings with a caption line (artist, year) per work; the generative works sit in a labelled accession group; no empty band taller than one caption line under a row.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-002",
      "targets": [
        "J14"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain/records/0x9c14ef75f511dd4e936931bd24cc8253a2fcd2b82bfdb8ddc586147a6afecd51 · default · all viewports · en-US",
      "evidence": "evidence/record-artist-1440x1000-01.png",
      "observation": "The Casey Reas artist page shows Museum ID, Status and Statement type, then 12 text links and a 'Creator of' list of 12 items (works and projects mixed), each followed by 'View relation'. No image, no works with dates, no summary of what the Museum holds by the artist.",
      "consequence": "The artist page does not present the artist or the holdings; the principal object (the artist's works in the collection) is a bare link list.",
      "change": "Split 'Creator of' into 'Works in the collection' (title, year, accession number) and 'Projects and series', and state the number of works held. Drop repeated 'View relation' from this list or move it to a secondary position.",
      "acceptance_check": "The artist page lists the seven works with year and accession number under a works heading, projects separately, and a held-works count that matches the index.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-003",
      "targets": [
        "J14",
        "M2"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain/records/0x65869cc503cc5fb4de77f15fd68b1c74515ec239b4f88cecc61eb6b820824817 and the work records · default · all viewports · en-US",
      "evidence": "evidence/record-work-portrait-1440x1000-02.png",
      "observation": "Caption depth differs between works: Take the Key! has no date and no credit line, its Medium reads 'photographic submission; final technical and identity state unverified' (a status caveat in the medium field), and 'Keys and Gates' is listed twice under Acquisition or program. Vera Molnar's record has date and caption but no credit line row, while CENTURY #31 has a credit line and no still. Reuse terms read 'The presentation manifest states no reuse terms.'",
      "consequence": "Credit lines and dates a museum would print are present for some works and absent for others; internal caveats and manifest wording appear as catalogue data.",
      "change": "Show Date, Medium, Credit line and Rights in one fixed order on every work record, with an explicit 'Not recorded' where the record has no value. Show the verification caveat as its own note, not inside Medium. Remove the duplicate program link or label the two (program, acquisition). Word the rights line for visitors, for example 'No reuse terms are stated for this image.'",
      "acceptance_check": "Take the Key!, Themes and Variations #210 and CENTURY #31 show the same labelled caption fields in the same order; no field holds a verification caveat; no link is listed twice without a distinguishing label.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-004",
      "targets": [
        "J14"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain/texts · default · all viewports · en-US",
      "evidence": "evidence/texts-1440x1000-01.png",
      "observation": "The 186 texts are listed as bare titles in two columns under accession and program groups. Essays, certificates, diligence memos and reviews (for example 'Casey REAS donation: custody, title, and compliance diligence', 'Accession certificate', 'The System in Seven States') carry the same weight, with no kind, author or date.",
      "consequence": "A reader cannot find the scholarship or judge its proportion against administrative documents; the section does not read as a publication.",
      "change": "Show the document kind (essay, certificate, review, dossier) after each title and list essays and catalogue texts before administrative documents within each group. Add the author and date where the record has them.",
      "acceptance_check": "Each text row shows its kind; in each accession group essays appear before certificates and reviews; the essay 'The System in Seven States' is identifiable as an essay from the list.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-005",
      "targets": [
        "J14"
      ],
      "severity": "P3",
      "status": "open",
      "where": "/museum/network-onchain/records/0x31319b05e3ca5dfcb48fcf40eb1ccfd8bdb74de165cb83869021e9e93ad71290 · default · 1440x1000 · en-US",
      "evidence": "evidence/record-work-1440x1000-02.png",
      "observation": "The Molnar image is a still of a live browser generator (Medium line says so) but the caption does not say the image is a still or its source.",
      "consequence": "Minor: a visitor may take the still for the work.",
      "change": "Add 'Still image' or the still's source to the caption.",
      "acceptance_check": "Caption names the image as a still of the live work.",
      "admission": "baseline",
      "reopen_reason": null
    }
  ],
  "preserve": [
    "Principal images shown whole at native aspect ratio (square Molnar, portrait Take the Key!) at all three widths",
    "Generative works with no still say so plainly and show no fallback panel",
    "Test-registry banner on every page keeps holdings and status honest",
    "'Not in the collection' stated on the record of selected works",
    "Credit line, rights and license wording on work records",
    "Essay text set in a readable measure with the verification line above it"
  ]
}