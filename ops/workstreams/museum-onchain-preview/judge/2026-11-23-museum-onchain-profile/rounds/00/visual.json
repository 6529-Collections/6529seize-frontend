  "findings": [
    {
      "id": "V-001",
      "targets": [
        "J05",
        "J03"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain · default · 1440x1000 and 820x1000",
      "evidence": "evidence/index-1440x1000-01.png",
      "observation": "The work grids top-align images of different heights in four columns. In 'Works in the collection' the first row has three landscape images and one tall portrait; below the three shorter ones there is an empty block of about 200 px. The same gaps occur in 'Works selected, not in the collection' and at 820 px (evidence/index-820x1000-01.png).",
      "consequence": "The grid reads as uneven and unfinished, and the eye cannot scan the works in order. Blank bands break the pacing of a page whose subject is the art.",
      "change": "Lay the works out in rows that share a height (justified rows with each image at its own aspect ratio), or fill columns top to bottom, so no cell leaves an empty band under shorter neighbours.",
      "acceptance_check": "At 1440, 820 and 390 px no grid row leaves a vertical gap larger than the caption height between an image block and the next row; every image keeps its aspect ratio.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "V-002",
      "targets": [
        "J02",
        "J10"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain and /museum/network-onchain/texts · default · 390x844",
      "evidence": "evidence/index-390x844-01.png",
      "observation": "The seven section chips on the index wrap onto six lines and fill most of the first screen at 390 px, so the first work appears only after about two screens. The texts page puts 14 group chips above the first text link (evidence/texts-390x844-02.png). On all viewports the chips scroll away with the page, and the index (9,200 px at 1440, 18,700 px at 390) offers no way back to the section list from far down.",
      "consequence": "A first-time reader on a phone scrolls past navigation before reaching content, and on long pages cannot jump between sections without scrolling back.",
      "change": "On narrow widths show the chips as one horizontally scrolling row or a single 'Jump to' control, and add a way back to the section list after each section.",
      "acceptance_check": "At 390 px the first work image or first text link is visible within the first 1.5 screens, and from the bottom of the index a visitor reaches any section in one tap.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "V-003",
      "targets": [
        "J03",
        "J05"
      ],
      "severity": "P2",
      "status": "open",
      "where": "All record routes · default · 1440x1000, 820x1000, 390x844",
      "evidence": "evidence/record-relation-1440x1000-01.png",
      "observation": "On every record page the 'On-chain facts' block (subject ID, record type, schema, content hash, canonical form, IPFS ID, effective, published, release, sequence, version, publisher, bytes served, with copy buttons) has the same type size and weight as the descriptive fields above it. On the declaration, relation and rights records it is longer than the content that identifies the record, and a further 'Full record' disclosure follows.",
      "consequence": "For records whose point is a title, a licence or a decision, the page weight sits in hashes instead of the record, so the reader cannot tell what is primary. At 390 px the meaning of the record is pushed below a long run of machine fields.",
      "change": "Keep Subject ID and Content hash visible and put the other stored fields (schema, canonical form, release, sequence, version, publisher, bytes) behind the existing 'Show every field' control, in a quieter style than the descriptive fields.",
      "acceptance_check": "On the rights, decision and relation records at 1440 and 390 px the on-chain facts block shows at most five rows until expanded, and the descriptive fields come first.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "V-004",
      "targets": [
        "J06",
        "J04"
      ],
      "severity": "P2",
      "status": "open",
