      "where": "/museum/network-onchain/records/0x31319b05e3ca5dfcb48fcf40eb1ccfd8bdb74de165cb83869021e9e93ad71290 · default · 1440x1000 · en-US",
      "evidence": "evidence/text/record-work-1440x1000.txt",
