  "findings": [
    {
      "id": "C-001",
      "targets": [
        "J14",
        "J01"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain · default · 1440x1000, 820x1000, 390x844 · en-US",
      "evidence": "evidence/index-1440x1000-02.png",
      "observation": "The collection section is still one flat thumbnail grid of 6 works, then a labelled but ungrouped text list of the seven Casey Reas works, then 16 selected works. Captions are title and artist only, with no year or accession. Uneven image heights still leave empty bands under captions (for example under Larry Towell and Patrolling the border). The generative-software sentence is new and helps, but there are no accession groupings.",
      "consequence": "A visitor cannot tell the accessions or the core of the collection from the index, and captions give no date, so it still reads as a file listing.",
      "change": "Group the 13 collection works under their three accessions with a one-line statement each, add year to each caption, and align rows so no band taller than a caption line sits under an image.",
      "acceptance_check": "At all three widths the collection section shows accession groupings, each work carries artist and year, and no empty band taller than one caption line appears under a row.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-002",
      "targets": [
        "J14"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain/records/0x9c14ef75f511dd4e936931bd24cc8253a2fcd2b82bfdb8ddc586147a6afecd51 · default · all viewports · en-US",
      "evidence": "evidence/text/record-artist-1440x1000.txt",
      "observation": "Connections now separates 'Works' (the seven works) from 'Creator of' (five projects), which fixes the mixing. Works are still bare title links each followed by 'View relation'; there is no year, accession number or count of works held, and the page opens with Museum ID, Status and Source of statement.",
      "consequence": "The artist page lists the holdings but does not present them as a catalogue: no dates, accession numbers or held-works count.",
      "change": "Show each work with year and accession number, state 'Seven works in the collection', and drop the repeated 'View relation' links to a secondary position.",
      "acceptance_check": "The artist page lists the seven works with year and accession number under a works heading, projects separately, and a held-works count that matches the index.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-003",
      "targets": [
        "J14",
        "M2"
      ],
      "severity": "P2",
      "status": "open",
      "where": "/museum/network-onchain/records/0x65869cc503cc5fb4de77f15fd68b1c74515ec239b4f88cecc61eb6b820824817 and the work records · default · all viewports · en-US",
      "evidence": "evidence/text/record-work-portrait-1440x1000.txt",
      "observation": "Duplicate Keys and Gates link is now labelled Acquisition and Acquisition program, and the rights line reads for visitors. Still open: Take the Key! shows Date 'Not recorded' and has no Credit line row; Vera Molnar's record has Date 2023 but no Credit line row; CENTURY #31 shows a Credit line. Medium for Take the Key! still reads 'photographic submission; final technical and identity state unverified' and CENTURY's medium ends 'Determinism of live behavior has not yet been independently verified', so verification caveats still sit in the Medium field.",
      "consequence": "The caption fields a museum would print differ between works, and status caveats still appear as catalogue data.",
      "change": "Show Date, Medium, Credit line and Rights in the same order on every work record, with 'Not recorded' where there is no value, and move verification caveats to their own labelled note.",
      "acceptance_check": "Take the Key!, Themes and Variations #210 and CENTURY #31 show the same labelled caption fields in the same order, and no Medium value contains a verification caveat.",
      "admission": "baseline",
      "reopen_reason": null
    },
    {
      "id": "C-004",
      "targets": [
        "J14"
      ],
      "severity": "P2",
