{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.io/schemas/telemetry-collector.v1.json",
  "title": "6529 first-party telemetry batch, v1",
  "description": "POST /e (6529.io) or /api/e (API). Body at most 8192 bytes, text/plain or application/json. Responds 204. Never send URLs, query strings, titles, handles, wallet addresses, ids or free text.",
  "type": "object",
  "required": [
    "v",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "events": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "v",
        "t",
        "route",
        "device",
        "platform"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "t": {
          "enum": [
            "pv",
            "vitals",
            "ev",
            "health"
          ]
        },
        "route": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^/(?:(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})(?:/(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})){0,7})?$",
          "description": "Route template such as `/waves/[wave]` or `/[user]/collected`. Static segments are lowercase; ids and names must be placeholders (`[name]`, `[...name]`, `[[...name]]` or `:name`). Unknown first segments and id-looking segments are recorded as `/[other]`."
        },
        "device": {
          "enum": [
            "mobile",
            "tablet",
            "desktop"
          ]
        },
        "platform": {
          "enum": [
            "web",
            "ios",
            "android",
            "desktop"
          ]
        },
        "page_group": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$"
        },
        "prev_route": {
          "anyOf": [
            {
              "const": "entry"
            },
            {
              "type": "string",
              "maxLength": 96,
              "pattern": "^/(?:(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})(?:/(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})){0,7})?$",
              "description": "Route template such as `/waves/[wave]` or `/[user]/collected`. Static segments are lowercase; ids and names must be placeholders (`[name]`, `[...name]`, `[[...name]]` or `:name`). Unknown first segments and id-looking segments are recorded as `/[other]`."
            }
          ]
        },
        "referrer_domain": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "External hostname only, sent only when prev_route is `entry`."
        },
        "browser": {
          "enum": [
            "chrome",
            "safari",
            "firefox",
            "edge",
            "other"
          ]
        },
        "signed_in": {
          "type": "boolean"
        },
        "fp": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,32}$",
          "description": "Optional coarse client hash for daily uniques (C52a). Used in memory only, never stored or logged. Omit for EU/EEA/UK/unknown-country visitors."
        },
        "lcp": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        },
        "inp": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        },
        "ttfb": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        },
        "fcp": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        },
        "cls": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "name": {
          "enum": [
            "Homepage section seen",
            "Homepage action clicked",
            "Profile section seen",
            "Profile action clicked",
            "Auth Forced Logout",
            "Auth Reauth Prompt Shown",
            "Auth Session Refresh Recovered",
            "Auth Session Upgrade Prompt Shown",
            "Auth Validation Failed While Connected",
            "Auth Session Refresh Succeeded",
            "Auth Validation Cancelled",
            "Auth Session Refresh Product Impact",
            "Wave Feed Load Started",
            "Wave Feed Load Succeeded",
            "Wave Feed Load Cancelled",
            "Wave Feed Load Failed",
            "Wave Feature Seen",
            "Wave Feature Activated"
          ]
        },
        "p": {
          "type": "object"
        },
        "c": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ws_drop": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "ws_reconnect": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "long_task": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "asset_fail": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "enum": [
                  "script",
                  "style",
                  "font",
                  "image",
                  "media",
                  "other"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "error": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "enum": [
                  "unhandled_error",
                  "unhandled_rejection",
                  "chunk_load",
                  "boundary",
                  "resource",
                  "other"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "api_fail": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^/(?:(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})(?:/(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})){0,7})?$",
                "description": "API endpoint template without `/api`, e.g. `/drops/[id]`."
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "api_slow": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^/(?:(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})(?:/(?:[a-z0-9][a-z0-9_-]{0,39}|\\[(?:\\.\\.\\.)?[A-Za-z]\\w{0,23}\\]|\\[\\[\\.\\.\\.[A-Za-z]\\w{0,23}\\]\\]|:[A-Za-z]\\w{0,23})){0,7})?$",
                "description": "API endpoint template without `/api`, e.g. `/drops/[id]`."
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          }
        },
        "ws_lag": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "Homepage section seen"
              }
            }
          },
          "then": {
            "properties": {
              "p": {
                "type": "object",
                "maxProperties": 6,
                "additionalProperties": false,
                "properties": {
                  "section": {
                    "type": "string",
                    "enum": [
                      "Introduction",
                      "Get started",
                      "How to start",
                      "Latest drop",
                      "Next drop",
                      "About 6529",
                      "Coming up",
                      "Boosted drops",
                      "Explore waves"
                    ]
                  },
                  "signed_in": {
                    "type": "boolean"
                  },
                  "is_native": {
                    "type": "boolean"
                  },
                  "screen_size": {
                    "type": "string",
                    "enum": [
                      "Small",
                      "Medium",
                      "Large"
                    ]
                  },
                  "layout_version": {
                    "type": "string",
                    "enum": [
                      "1"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "Homepage action clicked"
              }
            }
          },
          "then": {
            "properties": {
              "p": {
                "type": "object",
                "maxProperties": 6,
                "additionalProperties": false,
                "properties": {
                  "section": {
                    "type": "string",
                    "enum": [
                      "Introduction",
                      "Get started",
                      "How to start",
                      "Latest drop",
                      "Next drop",
                      "About 6529",
                      "Coming up",
                      "Boosted drops",
                      "Explore waves"
                    ]
                  },
                  "signed_in": {
                    "type": "boolean"
                  },
                  "is_native": {
                    "type": "boolean"
                  },
                  "screen_size": {
                    "type": "string",
