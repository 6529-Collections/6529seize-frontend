                  "refresh_outcome": {
                    "type": "string",
                    "enum": [
                      "cancelled",
                      "empty",
                      "failed",
                      "local_valid_after_failure",
                      "missing_wallet",
                      "not_attempted",
                      "success"
                    ]
                  },
                  "auth_state_after": {
                    "type": "string",
                    "enum": [
                      "authenticated",
                      "auth_validation_failed",
                      "logged_out",
                      "reauth_prompt",
                      "refresh_needed",
                      "session_upgrade_prompt",
                      "session_upgrade_required",
                      "wallet_connected"
                    ]
                  },
                  "product_failure": {
                    "type": "boolean"
