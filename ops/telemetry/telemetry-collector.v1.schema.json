                      "Open artwork",
                      "Open artist profile",
                      "Toggle edition details",
                      "View distribution plan",
                      "Mint",
                      "Manage subscriptions",
                      "About subscriptions",
                      "About submissions",
                      "View all",
                      "Open drop",
                      "Open wave"
                    ]
                  }
                }
              }
            }
