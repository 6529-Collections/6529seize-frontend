# Production load balancer accepts HTTPS only from CloudFront.
#
# 6529.io is served through the page distribution E3KTTDJUNHRYW9, which
# connects to this environment over HTTPS only. Allowing just the AWS-managed
# CloudFront origin-facing prefix list stops anyone from bypassing the edge
# (cache, compression and the purge-on-deploy contract) by calling the
# Elastic Beanstalk or load balancer hostname directly.
#
# This replaces the Elastic Beanstalk default (TCP 80 and 443 from 0.0.0.0/0).
# Port 80 stays closed: CloudFront never uses it, and viewers' HTTP requests
# are redirected to HTTPS at the edge. The prefix list counts as 55 of the
# security group's 60 inbound rules, so it is allowed on one port only.
#
# Target group health checks and instance traffic are unaffected: they run
# from the load balancer to the instances inside the VPC.
#
# Staging deploys through SSM to a plain instance and ignores this file.
# Runbook, verification and rollback: ops/docs/developer/cloudfront-page-cache.md
Resources:
  AWSEBLoadBalancerSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          SourcePrefixListId: pl-3b927c52
          Description: CloudFront origin-facing only (6529.io via E3KTTDJUNHRYW9)
